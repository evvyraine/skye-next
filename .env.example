TELEGRAM_BOT_TOKEN=
# Preferred: any OpenAI-compatible endpoint.
# SKYE_PROVIDER_API_KEY=
# SKYE_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# Legacy aliases (still work, SKYE_PROVIDER_* wins when set):
OPENAI_API_KEY=
# To use OpenRouter instead, leave OPENAI_API_KEY empty and set this key. If both
# are present, OpenRouter is selected so switching only requires adding its key.
# OPENROUTER_API_KEY=
SKYE_OWNER_IDS=
# Exa search (provider-independent web search/fetch, used instead of hosted tools).
# EXA key is read from SKYE_EXA_API_KEY.
# SKYE_EXA_API_KEY=
# Project API key from https://dashboard.composio.dev → Settings → API keys
# COMPOSIO_API_KEY=

# SKYE_DATABASE_PATH=data/skye.db
# SKYE_BASE_PROMPT_PATH=BASE_PROMPT.md
# SKYE_DEFAULT_MODEL=gpt-5.6-luna
# SKYE_DEFAULT_REASONING=medium
# SKYE_MAX_TURNS=20
# SKYE_RUN_TIMEOUT_SECONDS=300
# SKYE_COMPACTION_THRESHOLD_TOKENS=40000
# SKYE_MAX_CONTEXT_TOKENS=50000
# SKYE_MAX_OUTPUT_TOKENS=4000
# SKYE_TPM_BUDGET=1800000
# SKYE_MAX_CONCURRENT_RUNS=8
# SKYE_MAX_ATTACHMENT_BYTES=26214400
# SKYE_TRANSCRIPTION_MODEL=gpt-transcribe
# SKYE_SPEECH_MODEL=gpt-4o-mini-tts
# SKYE_IMAGE_MODEL=gpt-image-2
# SKYE_YOUTUBE_TRANSCRIPT_MAX_CHARS=48000
# Optional HTTP(S) proxy. Cloud-provider IPs are often blocked by YouTube.
# A rotating residential proxy is the most reliable production option.
# SKYE_YOUTUBE_PROXY_URL=
# OpenRouter model slugs are configured through the same variables, for example:
# SKYE_DEFAULT_MODEL=anthropic/claude-sonnet-4.6
# SKYE_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# SKYE_SPEECH_MODEL=openai/gpt-4o-mini-tts
# SKYE_IMAGE_MODEL=openai/gpt-5-image
# SKYE_GROUP_CONTEXT_MESSAGES=20
# SKYE_GROUP_CONTEXT_MESSAGE_CHARS=1500
# SKYE_GROUP_CONTEXT_TOTAL_CHARS=16000
# Own Docker sandbox for shell_exec (one container per command, fresh workdir
# per turn, files delivered through deliver_file). Disabled by default.
# SKYE_SANDBOX_ENABLED=true
# SKYE_SANDBOX_IMAGE=python:3.14-slim
# SKYE_SANDBOX_TIMEOUT_SECONDS=120
# SKYE_SANDBOX_ALLOW_NETWORK=false
# Comma-separated domains reserved for future sandbox egress filtering.
# SKYE_SANDBOX_ALLOWED_DOMAINS=pypi.org,files.pythonhosted.org,github.com
# SKYE_TRACING=false
# Web chat at chat.skye-bot.com (Telegram Login OIDC from BotFather → Login Widget).
# Production sits behind Caddy; the container publishes 127.0.0.1:18780.
# SKYE_WEB_ORIGIN=https://chat.skye-bot.com
# SKYE_WEB_HOST=127.0.0.1
# SKYE_WEB_PORT=8080
# SKYE_WEB_FILES_PATH=/data/web
# TELEGRAM_LOGIN_CLIENT_ID=
# TELEGRAM_LOGIN_CLIENT_SECRET=
