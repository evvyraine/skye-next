TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
SKYE_OWNER_IDS=
# Project API key from https://dashboard.composio.dev → Settings → API keys
# COMPOSIO_API_KEY=

# SKYE_DATABASE_PATH=data/skye.db
# SKYE_BASE_PROMPT_PATH=BASE_PROMPT.md
# SKYE_DEFAULT_MODEL=gpt-5.6-luna
# SKYE_DEFAULT_REASONING=medium
# SKYE_MAX_TURNS=20
# SKYE_RUN_TIMEOUT_SECONDS=300
# SKYE_COMPACTION_THRESHOLD_TOKENS=40000
# SKYE_MAX_CONTEXT_TOKENS=50000
# SKYE_MAX_OUTPUT_TOKENS=4000
# SKYE_TPM_BUDGET=1800000
# SKYE_MAX_CONCURRENT_RUNS=8
# SKYE_MAX_ATTACHMENT_BYTES=26214400
# SKYE_TRANSCRIPTION_MODEL=gpt-transcribe
# SKYE_GROUP_CONTEXT_MESSAGES=20
# SKYE_GROUP_CONTEXT_MESSAGE_CHARS=1500
# SKYE_GROUP_CONTEXT_TOTAL_CHARS=16000
# Comma-separated domains the hosted sandbox may reach. Must be a subset of the
# org container allow list in the OpenAI dashboard.
# SKYE_SANDBOX_ALLOWED_DOMAINS=pypi.org,files.pythonhosted.org,github.com
# SKYE_TRACING=false
# Web chat at chat.skye-bot.com (Telegram Login OIDC from BotFather → Login Widget).
# Production sits behind Caddy; the container publishes 127.0.0.1:18780.
# SKYE_WEB_ORIGIN=https://chat.skye-bot.com
# SKYE_WEB_HOST=127.0.0.1
# SKYE_WEB_PORT=8080
# SKYE_WEB_FILES_PATH=/data/web
# TELEGRAM_LOGIN_CLIENT_ID=
# TELEGRAM_LOGIN_CLIENT_SECRET=
